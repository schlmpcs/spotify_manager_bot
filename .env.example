# ── This automation bot (create a NEW bot via @BotFather) ──
BOT_TOKEN=
OWNER_IDS=[123456789]          # your manager Telegram user id(s)

# ── LLM (OpenRouter — free-model fallback chain) ──
OPENROUTER_API_KEY=                       # https://openrouter.ai/keys
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Ordered chain of free models; on 429/error the next is tried. JSON list.
LLM_MODELS=["deepseek/deepseek-chat-v3.1:free","meta-llama/llama-3.3-70b-instruct:free","qwen/qwen-2.5-72b-instruct:free","google/gemini-2.0-flash-exp:free","mistralai/mistral-small-3.2-24b-instruct:free"]
LLM_TIMEOUT=60
LLM_MAX_TOKENS=280

# ── Main payment bot's PostgreSQL (read-only grounding) ──
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_SSL_MODE=require            # 'disable' for local dev

# ── This bot's own state store ──
LOCAL_DB_PATH=./data/manager.db

# ── Behaviour ──
AUTO_REPLY=true               # auto-send replies to incoming messages
PROACTIVE_MODE=approve        # auto | approve | off
PROACTIVE_HOUR=12
PROACTIVE_OVERDUE_DAYS=1
PROACTIVE_COOLDOWN_DAYS=3
BOT_TIMEZONE=Asia/Almaty

# ── Pricing (to state amounts owed) ──
KZ_GROUP_PRICE=700
RU_GROUP_PRICE=200
SUPPORT_USERNAME=sptfy_premium
