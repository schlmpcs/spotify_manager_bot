# ── This automation bot (create a NEW bot via @BotFather) ──
BOT_TOKEN=
OWNER_IDS=[123456789]          # your manager Telegram user id(s)

# ── LLM (any OpenAI-compatible API — pick ONE provider below) ──
# OpenAI (reliable, paid; cheap with gpt-4o-mini):
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=                              # sk-... from platform.openai.com
LLM_MODELS=["gpt-4o-mini"]
#
# OpenRouter (free models, rate-limited):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-...                 # https://openrouter.ai/keys
#   LLM_MODELS=["meta-llama/llama-3.3-70b-instruct:free","deepseek/deepseek-r1:free"]
#
# Local Ollama on a GPU box (free, private; bot must reach the GPU host):
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_API_KEY=ollama                    # any non-empty placeholder
#   LLM_MODELS=["qwen2.5:7b-instruct"]
#
LLM_TIMEOUT=60
LLM_MAX_TOKENS=280

# ── Main payment bot's PostgreSQL (read-only grounding) ──
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_SSL_MODE=require            # 'disable' for local dev

# ── This bot's own state store ──
LOCAL_DB_PATH=./data/manager.db

# ── Behaviour ──
AUTO_REPLY=true               # auto-send replies to incoming messages
REPLY_RATE_PER_MIN=15         # abuse guard: max AI replies per customer / minute
REPLY_RATE_PER_HOUR=150       # abuse guard: max AI replies per customer / hour
REPLY_DEBOUNCE_SECONDS=2.5    # wait this long for follow-up messages, then answer the whole burst at once
MANAGER_TAKEOVER_HOURS=24     # after the manager replies by hand, stay silent in that chat this long
PROACTIVE_MODE=auto           # auto (send as manager) | approve (one-tap) | off
PROACTIVE_HOUR=12             # staged overdue nudges run daily at this hour (BOT_TIMEZONE)
PROACTIVE_OVERDUE_DAYS=1      # start the day-1 nudge once this many days overdue
PROACTIVE_COOLDOWN_DAYS=3     # legacy; staging now advances one step per calendar day
BOT_TIMEZONE=Asia/Almaty      # Almaty = UTC+5; PROACTIVE_HOUR=12 → noon Almaty

# ── Pricing (to state amounts owed + quote prices to prospects) ──
KZ_GROUP_PRICE=700
RU_GROUP_PRICE=200
KZ_INDIVIDUAL_PRICE=1500
RU_INDIVIDUAL_PRICE=250
KZ_DUO_PRICE=2500
RU_DUO_PRICE=600

# ── Payment requisites quoted to overdue customers in nudges ──
KZ_PAYMENT_LINK=https://pay.kaspi.kz/pay/besmk1m9   # Kaspi link for KZ customers
RU_PAYMENT_CARD=                                     # card number for RU transfers
RU_PAYMENT_BANK=VTB Bank                             # bank name for RU transfers
RU_PAYMENT_RECIPIENT=                                # recipient name for RU transfers

SUPPORT_USERNAME=sptfy_premium
PURCHASE_BOT_USERNAME=sptfy_premium_bot   # bot where NEW customers buy/connect
CHANNEL_URL=https://t.me/sptfykz          # channel link shared with new customers
